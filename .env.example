# Владелец схемы: миграции и сиды (обходит RLS)
MIGRATION_DATABASE_URL=postgres://vols:vols@localhost:5432/vols
# Роль приложения: без BYPASSRLS, все запросы идут через политики RLS
DATABASE_URL=postgres://vols_app:vols_app@localhost:5432/vols
# Пароль роли vols_app, используется init-скриптом docker
VOLS_APP_PASSWORD=vols_app
API_PORT=3000
